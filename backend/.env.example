# Application
APP_NAME="Glot API"
APP_VERSION="0.1.0"
DEBUG=true

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/glot"
DATABASE_URL_SYNC="postgresql+psycopg2://postgres:postgres@localhost:5432/glot"
# Force SQLAlchemy NullPool (recommended for external poolers like Supabase/Neon pooler URLs)
DATABASE_USE_NULL_POOL=false

# Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=

# CORS (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:3000"]

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Redis (local Docker or external like Upstash)
REDIS_URL=redis://localhost:6379

# Extraction Agent
OPENROUTER_API_KEY=
